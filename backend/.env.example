# ── 运行模式 ──────────────────────────────────────────────
ENVIRONMENT=dev
LOG_LEVEL=INFO

# mock = 不调用外部模型（默认，离线可跑）；deepseek / openai / ollama
LLM_PROVIDER=mock
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0

# 例：DeepSeek（2026-10 实测可用；模型 id 以 GET /v1/models 为准）
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=sk-xxxx
# LLM_BASE_URL=https://api.deepseek.com/v1

# ── 向量化 ────────────────────────────────────────────────
# hashing = 本地确定性哈希向量（零下载，相似度偏低 → 阈值建议 0.24）
# openai  = 任意 OpenAI 兼容 embeddings 接口（相似度高 → 阈值建议 0.35~0.45）
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=10    # 千问 v3 单批上限 10，超了直接 400

# 例：千问 text-embedding-v3（1024 维，DashScope 兼容模式）
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=sk-xxxx
# EMBEDDING_DIM=1024

# ── 检索参数 ──────────────────────────────────────────────
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.24
RETRIEVAL_MAX_PER_DOC=3
CHUNK_SIZE=420
CHUNK_OVERLAP=80

# ── 业务规则 ──────────────────────────────────────────────
REFUND_AUTO_LIMIT=300
REFUND_WINDOW_DAYS=7
QUALITY_REFUND_WINDOW_DAYS=15

# ── 持久化 ────────────────────────────────────────────────
CHECKPOINTER_BACKEND=sqlite
SQLITE_CHECKPOINT_PATH=./data/checkpoints.db
SQLITE_PATH=./data/support.db
# CHECKPOINTER_BACKEND=postgres
# POSTGRES_URL=postgresql://support:support@localhost:5432/support

# ── 认证与授权（JWT + RBAC）──────────────────────────────
# 生产必须注入随机密钥（≥32 字节），可用 python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-please-32bytes
JWT_EXPIRE_MINUTES=480
# 演示账号初始密码（首次启动时写入 users 表，PBKDF2 加盐存储）
DEMO_PASSWORD=demo1234
# 审核员单笔可批上限，超过需要 admin
AGENT_APPROVAL_LIMIT=5000

# ── 前端来源 ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
